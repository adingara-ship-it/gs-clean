---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout
  title="Nettoyage La Louvière | GS Clean"
  description="GS Clean réalise vos nettoyages à La Louvière: vitres, tissus et fin de chantier. Devis gratuit."
>
  <Fragment slot="head">
    <link rel="canonical" href="https://www.gsclean.be/nettoyage/la-louviere/" />
  </Fragment>

  <main class="local-page">
    <section class="section">
      <div class="container">
        <p class="kicker">Zone d'intervention</p>
        <h1>Nettoyage professionnel à La Louvière</h1>
        <p class="local-lead">
          GS Clean intervient rapidement à La Louvière pour les particuliers, commerces et entreprises. Notre objectif: un résultat propre, visible et durable.
        </p>
      </div>
    </section>

    <section class="section local-block">
      <div class="container">
        <div class="zone-grid">
          <article class="zone-card">
            <h3>Vitres et vitrines</h3>
            <p>Entretien ponctuel ou régulier pour une visibilité nette, sans traces.</p>
          </article>
          <article class="zone-card">
            <h3>Canapés et textiles</h3>
            <p>Injection-extraction pour assainir les tissus et améliorer leur tenue dans le temps.</p>
          </article>
          <article class="zone-card">
            <h3>Fin de chantier</h3>
            <p>Remise en état complète avant livraison ou réouverture de vos espaces.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container cta-wrap">
        <div>
          <p class="kicker">Contact rapide</p>
          <h2>Besoin d'un nettoyage à La Louvière ?</h2>
        </div>
        <div class="cta-actions">
          <a class="btn" href="tel:+32499469093">0499 46 90 93</a>
          <a class="btn btn-alt" href="mailto:info@gsclean.be">Demander un devis</a>
        </div>
      </div>
    </section>
  </main>
</MainLayout>
