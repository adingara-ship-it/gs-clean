---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout
  title="Nettoyage Nivelles | GS Clean"
  description="GS Clean vous accompagne à Nivelles pour le nettoyage de vitres, tissus et fin de chantier."
>
  <Fragment slot="head">
    <link rel="canonical" href="https://www.gsclean.be/nettoyage/nivelles/" />
  </Fragment>

  <main class="local-page">
    <section class="section">
      <div class="container">
        <p class="kicker">Zone d'intervention</p>
        <h1>Service de nettoyage à Nivelles</h1>
        <p class="local-lead">
          GS Clean propose à Nivelles un service fiable, ponctuel et orienté qualité, avec des interventions adaptées à votre rythme et vos contraintes.
        </p>
      </div>
    </section>

    <section class="section local-block">
      <div class="container">
        <div class="zone-grid">
          <article class="zone-card">
            <h3>Entretien de surfaces vitrées</h3>
            <p>Pour habitations, vitrines commerciales et espaces professionnels.</p>
          </article>
          <article class="zone-card">
            <h3>Nettoyage textile</h3>
            <p>Canapés, tapis et sièges avec une méthode adaptée aux matières sensibles.</p>
          </article>
          <article class="zone-card">
            <h3>Remise en état</h3>
            <p>Après travaux ou déménagement, pour repartir sur une base impeccable.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container cta-wrap">
        <div>
          <p class="kicker">Contact rapide</p>
          <h2>Demander une intervention à Nivelles</h2>
        </div>
        <div class="cta-actions">
          <a class="btn" href="tel:+32499469093">Appeler GS Clean</a>
          <a class="btn btn-alt" href="mailto:info@gsclean.be">Demander un devis</a>
        </div>
      </div>
    </section>
  </main>
</MainLayout>
