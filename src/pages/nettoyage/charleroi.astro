---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout
  title="Nettoyage Charleroi | GS Clean"
  description="GS Clean réalise vos prestations de nettoyage à Charleroi avec un haut niveau de finition."
>
  <Fragment slot="head">
    <link rel="canonical" href="https://www.gsclean.be/nettoyage/charleroi/" />
  </Fragment>

  <main class="local-page">
    <section class="section">
      <div class="container">
        <p class="kicker">Zone d'intervention</p>
        <h1>Nettoyage à Charleroi pour particuliers et entreprises</h1>
        <p class="local-lead">
          À Charleroi, GS Clean intervient avec un protocole clair: analyse du besoin, devis rapide, intervention soignée et contrôle final.
        </p>
      </div>
    </section>

    <section class="section local-block">
      <div class="container">
        <div class="zone-grid">
          <article class="zone-card">
            <h3>Vitres et façades vitrées</h3>
            <p>Résultat net pour améliorer la luminosité et la perception de propreté.</p>
          </article>
          <article class="zone-card">
            <h3>Tissus et mobilier</h3>
            <p>Nettoyage profondeur pour canapés, fauteuils et tapis à usage intensif.</p>
          </article>
          <article class="zone-card">
            <h3>Locaux après chantier</h3>
            <p>Intervention complète pour rendre les lieux immédiatement utilisables.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container cta-wrap">
        <div>
          <p class="kicker">Contact rapide</p>
          <h2>Obtenir un devis à Charleroi</h2>
        </div>
        <div class="cta-actions">
          <a class="btn" href="tel:+32499469093">0499 46 90 93</a>
          <a class="btn btn-alt" href="mailto:info@gsclean.be">Envoyer ma demande</a>
        </div>
      </div>
    </section>
  </main>
</MainLayout>
