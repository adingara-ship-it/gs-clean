---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout
  title="Nettoyage Mons | GS Clean"
  description="Service de nettoyage à Mons pour professionnels et particuliers: vitres, tissus et fin de chantier."
>
  <Fragment slot="head">
    <link rel="canonical" href="https://www.gsclean.be/nettoyage/mons/" />
  </Fragment>

  <main class="local-page">
    <section class="section">
      <div class="container">
        <p class="kicker">Zone d'intervention</p>
        <h1>Entreprise de nettoyage à Mons</h1>
        <p class="local-lead">
          GS Clean accompagne les clients de Mons avec des interventions ponctuelles ou régulières, adaptées à chaque type de surface.
        </p>
      </div>
    </section>

    <section class="section local-block">
      <div class="container">
        <div class="zone-grid">
          <article class="zone-card">
            <h3>Commerces et bureaux</h3>
            <p>Nettoyage soigné pour maintenir une image professionnelle auprès de vos clients.</p>
          </article>
          <article class="zone-card">
            <h3>Habitations</h3>
            <p>Prestations sur mesure pour vitres, tissus et entretien général de vos espaces.</p>
          </article>
          <article class="zone-card">
            <h3>Après travaux</h3>
            <p>Élimination des poussières fines et nettoyage détaillé avant occupation.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container cta-wrap">
        <div>
          <p class="kicker">Contact rapide</p>
          <h2>Planifier votre intervention à Mons</h2>
        </div>
        <div class="cta-actions">
          <a class="btn" href="tel:+32499469093">Appeler GS Clean</a>
          <a class="btn btn-alt" href="mailto:info@gsclean.be">Recevoir un devis</a>
        </div>
      </div>
    </section>
  </main>
</MainLayout>
